# Тип хранилища
STORAGE_TYPE=postgres

# Подключение к БД (внутри docker сети)
DATABASE_URL=postgres://postgres:postgres@db:5432/commentSystem?sslmode=disable

# Параметры БД (используются контейнером postgres)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=commentSystem

# Порт приложения
APP_PORT=8080